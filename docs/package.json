{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "supabase-docs",
  "title": "Supabase Docs",
  "description": "Fuzzy-find Supabase guides documentation and pin frequently used pages.",
  "icon": "extension-icon.png",
  "author": "apdarr",
  "platforms": ["macOS"],
  "categories": ["Documentation", "Developer Tools"],
  "license": "MIT",
  "commands": [
    {
      "name": "search-docs",
      "title": "Search Docs",
      "subtitle": "Supabase Docs",
      "description": "Search Supabase guides docs and open or pin pages.",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.21",
    "@raycast/utils": "^2.2.7"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.0.4",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint"
  }
}
